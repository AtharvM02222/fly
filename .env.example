# =============================================================================
# Drone-CDS v2 Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------

# Database (Postgres with PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dronecds
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (for rate limiting and caching)
REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-here-replace-with-random-256-bit-hex
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# API Keys
# Salt for hashing device API keys
API_KEY_SALT=your-api-key-salt-here-replace-with-random-string

# Rate Limiting
RATE_LIMIT_PER_DEVICE_PER_MINUTE=100

# Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dronecds-detections
S3_REGION=us-east-1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Deduplication
DEDUP_GEOHASH_PRECISION=7
DEDUP_DISTANCE_METERS=150
DEDUP_TIME_WINDOW_MINUTES=5

# Notifications
NOTIFICATION_SEVERITY_THRESHOLD=medium
NOTIFICATION_COOLDOWN_MINUTES=60

# -----------------------------------------------------------------------------
# Edge Configuration
# -----------------------------------------------------------------------------

# Backend Connection
EDGE_BACKEND_URL=http://localhost:8000/api/v1
EDGE_DEVICE_ID=device-001
EDGE_DEVICE_API_KEY=your-device-api-key-here

# Camera
EDGE_CAMERA_SOURCE=0
# Can be: 0 (camera index), /path/to/video.mp4, rtsp://camera-url
EDGE_CAMERA_FRAME_SAMPLE_RATE=3
# Process every Nth frame

# GPS
EDGE_GPS_SOURCE=/dev/ttyUSB0
# Serial port for GPS, or "mock" for testing
EDGE_GPS_BAUD_RATE=9600

# Detector
EDGE_DETECTOR_MODEL_PATH=models/pothole.onnx
EDGE_DETECTOR_ENGINE_PATH=models/pothole.engine
EDGE_DETECTOR_WEIGHTS_CHECKSUM=sha256:placeholder
EDGE_DETECTOR_BACKEND=auto
# Options: tensorrt, onnx-cuda, onnx-cpu, auto
EDGE_DETECTOR_CONFIDENCE_THRESHOLD=0.5
EDGE_DETECTOR_NMS_IOU_THRESHOLD=0.45
EDGE_DETECTOR_MAX_DETECTIONS=50
EDGE_DETECTOR_INPUT_SIZE=640
EDGE_DETECTOR_QUANTIZATION=none
# Options: none, fp16, int8

# Tracker
EDGE_TRACKER_IOU_THRESHOLD=0.3
EDGE_TRACKER_MIN_HITS=3
EDGE_TRACKER_MAX_AGE=30

# Severity
EDGE_SEVERITY_CAMERA_HEIGHT_M=2.0
EDGE_SEVERITY_CAMERA_ANGLE_DEG=45

# Buffer
EDGE_BUFFER_DB_PATH=edge/buffer.db
EDGE_BUFFER_MAX_RETRIES=10

# Uplink
EDGE_UPLINK_BATCH_SIZE=10
EDGE_UPLINK_INTERVAL_SECONDS=30
EDGE_UPLINK_RETRY_BACKOFF_BASE=2
EDGE_UPLINK_RETRY_MAX_DELAY=300

# Performance
EDGE_LATENCY_BUDGET_MS=100

# -----------------------------------------------------------------------------
# Dashboard Configuration
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here
# Or use OSM tiles without token

# -----------------------------------------------------------------------------
# Docker Development
# -----------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=dronecds
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dronecds
